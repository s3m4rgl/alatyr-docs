# Внешние порты. Меняйте, если 8090 или 3000 на машине уже заняты —
# внутри контейнеров порты остаются прежними.
ALATYR_API_PORT=8090
ALATYR_UI_PORT=3000

# ── Версия поставки ──────────────────────────────────────────────────────────
# Тег образов server/frontend в Docker Hub. Обязателен: значения по умолчанию
# нет, и `latest` мы не публикуем намеренно. Берите из релизных заметок.
ALATYR_IMAGE_TAG=

# Переопределение адреса образов — если вы перелили их в свой реестр.
# ALATYR_SERVER_IMAGE=registry.corp.example/alatyr/server
# ALATYR_UI_IMAGE=registry.corp.example/alatyr/frontend

# Alatyr Server — environment configuration
# Canonical names below; legacy names still work (a deprecation warning is logged).
#
# Любое имя ниже принимает форму <ИМЯ>_FILE: значение берётся из файла.
# Для секретов это предпочтительно: переменная окружения видна в
# `docker inspect` и в /proc/<pid>/environ, файл — нет.
# Пример: VAULT_SECRET_ID_FILE=/run/secrets/vault_secret_id

# HTTP listen port. (default: 8090)
ALATYR_SERVER_PORT=8090

# PostgreSQL connection string, e.g. postgres://user:pass@host:5432/alatyr.
#
# ОБЯЗАТЕЛЕН, КОГДА СЕРВЕР ЗАПУСКАЮТ НЕ ЧЕРЕЗ НАШ `docker-compose.yml`.
# В составе эта переменная НЕ ДЕЙСТВУЕТ: строку подключения он собирает сам из
# `DB_PASSWORD` (см. ниже), и заполненное здесь значение молча игнорируется.
# Раньше строка была помечена просто `(REQUIRED)`, и честно заполнивший её
# клиент получал проигнорированное значение.
ALATYR_DB_URL=

# Comma-separated allowed CORS origins. Defaults to localhost dev ports.
ALATYR_CORS_ORIGINS=

# Список CIDR обратных прокси, чьему X-Forwarded-For сервер верит. ПУСТО по умолчанию: ClientIP это адрес TCP-пира, заголовки вызывающего не читаются. Под k8s ingress ходит в Service напрямую, поэтому без этой настройки у ВСЕХ вызывающих один и тот же ClientIP и любой ограничитель по адресу становится общим пределом на весь мир. Задавать CIDR только тех прокси, которые действительно стоят перед сервером: доверие лишнему возвращает подмену адреса.
ALATYR_TRUSTED_PROXIES=

# debug | info | warn | error. (default: info)
ALATYR_LOG_LEVEL=info

# Default Wi-Fi SSID seeded on first boot when wifi_ssids is empty. (default: CorpWiFi)
ALATYR_DEFAULT_SSID=CorpWiFi

# Dev shortcut: accept 'Bearer dev-token' as cert-admin. NEVER in production. (default: false)
ALATYR_DEV_MODE=false

# Enable email+password local auth alongside Keycloak. (default: false)
ALATYR_LOCAL_AUTH_ENABLED=false

# HS256 signing secret for local sessions. >=32 bytes. Required when local auth is enabled.
# set me — never commit a real value
ALATYR_LOCAL_JWT_SECRET=

# Bootstrap first local admin when the users table is empty.
ALATYR_LOCAL_ADMIN_EMAIL=

# Bootstrap admin password. Remove from the deployment manifest after first boot.
# set me — never commit a real value
ALATYR_LOCAL_ADMIN_PASSWORD=

# Local access-token TTL in minutes. (default: 15)
ALATYR_LOCAL_ACCESS_TTL_MIN=15

# Local refresh-token TTL in days. (default: 30)
ALATYR_LOCAL_REFRESH_TTL_DAYS=30

# Enable on-demand device-log collection. (default: false)
ALATYR_REMOTE_LOGS_ENABLED=false

# Opt-in: let a placeholder-serial device re-enroll onto its prior device row by presenting its own continuity_key, avoiding license-slot churn on reinstall. Default false (security-favoring): every placeholder-serial enroll always gets a new row. There is no way to cryptographically prove 'same machine' for non-attested hardware over an unauthenticated channel — this trade-off is explicit and operator-controlled, not engineered away. (default: false)
ALATYR_PLACEHOLDER_CONTINUITY_MERGE_ENABLED=false

# Omit the macOS WiFi/wired .mobileconfig from the agent certificate response (agent skips its own profile install). Set when macOS profiles are distributed by MDM. Does not affect the admin bundle ZIP. (default: false)
ALATYR_MACOS_AGENT_PROFILE_DISABLED=false

# Enable outgoing webhooks (endpoints, signed delivery, worker). (default: false)
ALATYR_WEBHOOKS_ENABLED=false

# AES-256 key (64 hex chars) encrypting webhook secrets at rest. Required when webhooks are enabled.
# set me — never commit a real value
ALATYR_WEBHOOK_ENC_KEY=

# Webhook delivery worker poll interval (seconds). (default: 10)
ALATYR_WEBHOOK_POLL_SECONDS=10

# Days to retain webhook delivery records before pruning. (default: 30)
ALATYR_WEBHOOK_RETENTION_DAYS=30

# Max delivery attempts before a webhook delivery is marked failed. (default: 6)
ALATYR_WEBHOOK_MAX_ATTEMPTS=6

# Export OpenTelemetry traces. Off by default; requires ALATYR_OTEL_ENDPOINT. (default: false)
ALATYR_OTEL_ENABLED=false

# OTLP/HTTP collector endpoint (host:port, e.g. otel-collector:4318). Required when ALATYR_OTEL_ENABLED=true.
ALATYR_OTEL_ENDPOINT=

# service.name reported on exported spans. (default: alatyr-server)
ALATYR_OTEL_SERVICE_NAME=alatyr-server

# Send OTLP over plaintext HTTP. Default true because a collector is normally an in-cluster sidecar; set false to require TLS. (default: true)
ALATYR_OTEL_INSECURE=true

# Head sampling ratio 0.0-1.0 for traces started by this service. Sampling decisions arriving in traceparent/b3 are always respected. (default: 1)
ALATYR_OTEL_SAMPLE_RATIO=1

# Certificate issuer backend: vault | scep. (default: vault)
ALATYR_ISSUER=vault

# External SCEP CA URL (required when issuer=scep).
ALATYR_SCEP_URL=

# SCEP challenge password (required when issuer=scep).
# set me — never commit a real value
ALATYR_SCEP_CHALLENGE=

# Expected SHA-256 fingerprint of the SCEP CA cert (required when issuer=scep).
ALATYR_SCEP_CA_FINGERPRINT=

# SCEP CA identifier for multi-CA setups (NDES). Optional.
ALATYR_SCEP_CA_IDENTIFIER=

# AES-256 key (64 hex chars) encrypting SCEP poll state at rest. Required when issuer=scep.
# set me — never commit a real value
ALATYR_SCEP_ENC_KEY=

# SCEP pending-poll interval (seconds). (default: 30)
ALATYR_SCEP_POLL_SECONDS=30

#: разрешить http:// в ALATYR_SCEP_URL. По умолчанию false — на открытом канале положение «в разрыве» подменяет ответ GetCACert целиком, а он определяет и получателей конверта, и корневой сертификат, который уезжает на каждую машину парка. Включать только там, где путь до NDES защищён иначе; каждый запуск с ним пишет предупреждение. (default: false)
ALATYR_SCEP_ALLOW_PLAINTEXT_URL=false

# Comma-separated CIDRs the SCEP issuer may reach despite the SSRF guard (an on-prem ADCS/NDES always has a private address). Empty = unchanged behaviour. Link-local is never allowed, even if listed.
ALATYR_SCEP_INTERNAL_CIDRS=

# Minutes a device may sit agent_update_pending_since before reconcile.StuckAgentUpdate flags/audits it as never having checked in with the forced update. (default: 30)
ALATYR_AGENT_UPDATE_ALERT_MINUTES=30

#: directory of vendor-signed per-platform agent update manifests (<platform>.json). Empty disables the managed-rollout channel entirely -- no manifest is attached on checkin and the Admin UI reports the channel as not configured, rather than showing a control that silently does nothing. The reserved platform "server" (server.json,) carries the PLATFORM release version instead of an agent build: it is never offered to a device, and drives the admin-only update notice at GET /settings/platform-update.
ALATYR_AGENT_UPDATE_MANIFEST_DIR=

#: LDAP/AD адрес (ldaps://dc.example.local:636) для получения SID человека по UPN. Пусто (умолчание) — каталог не настроен: маршрут /enroll/identity-sid не регистрируется, а перепроверка SID при выдаче ad_logon не производится. Нужен там, где агенты стоят на НЕдоменных хостах (и на macOS): у них локальный SID домену неизвестен, а без SID сертификат для входа в домен непригоден.
ALATYR_DIRECTORY_URL=

#: DN учётной записи для привязки к каталогу. Требуется только право ЧИТАТЬ objectSid — этот сервис в каталог не пишет никогда.
ALATYR_DIRECTORY_BIND_DN=

#: пароль учётной записи привязки к каталогу.
# set me — never commit a real value
ALATYR_DIRECTORY_BIND_PASSWORD=

#: поддерево поиска (DC=example,DC=local). Из его компонентов DC= выводится раздел конфигурации леса, в котором ищется точка распространения списков отзыва — значение без DC= ломает доставку CRL.
ALATYR_DIRECTORY_BASE_DN=

#: не проверять сертификат контроллера домена. Только для тестовых установок с самоподписанным сертификатом; в бою НИКОГДА — пароль привязки уходит в это соединение. (default: false)
ALATYR_DIRECTORY_INSECURE_SKIP_VERIFY=false

#: сколько РАЗЛИЧНЫХ личностей одно устройство может разрешить в SID за сутки, если эти личности не одобрены человеком. Нужно, чтобы недоменный хост мог получить сертификат «себе»; границей служит именно число личностей, а не запросов — агент приходит каждый тик, и счётчик запросов выел бы квоту за час. Личности с одобренным сертификатом или названные в директиве администратора квоту НЕ тратят. 0 запрещает самообслуживание целиком. (default: 3)
ALATYR_DIRECTORY_SID_DAILY_LIMIT=3

#: потолок времени на подключение и поиск в каталоге. Не украшение: неотвечающий контроллер домена не должен подвешивать выдачу. (default: 5)
ALATYR_DIRECTORY_TIMEOUT_SECONDS=5

#: Apple App Attest app identifier, "<TeamID>.<BundleID>". Empty (default) disables App Attest entirely -- the /enroll/app-attest endpoints answer 503 and the approval-time ladder has nothing to enforce. macOS only.
ALATYR_APP_ATTEST_APP_ID=

#: which App Attest environment to accept -- appattest (production), or appattestdevelop / appattestsandbox (the same non-production environment under both of the names Apple's documentation uses; either value admits both spellings on the wire). A security control, not a build flag: a non-production attestation comes from a build any developer can run on any device, and production admits neither spelling. (default: appattest)
ALATYR_APP_ATTEST_ENVIRONMENT=appattest

#: адрес отдельного TLS-слушателя брокера эфемерных credential для kubectl (например ":8443"). Пусто (по умолчанию) — брокер выключен целиком, и это штатное состояние: у большинства развёртываний Kubernetes нет вовсе. Слушатель отдельный, потому что он ЗАПРАШИВАЕТ клиентский сертификат, а выставлять на такой порт всю остальную админскую поверхность незачем.
ALATYR_K8S_BROKER_LISTEN=

#: адрес брокера, каким его видит УСТРОЙСТВО (например https://alatyr.corp:8443). Отдаётся агенту опросом целей: слушатель брокера живёт на своём порту, и угадать его устройство не может. Пусто — плагин kubectl скажет, что это развёртывание credential не выдаёт, вместо того чтобы гадать.
ALATYR_K8S_BROKER_URL=

#: PEM-файл серверного сертификата брокера. Обязателен, если задан ALATYR_K8S_BROKER_LISTEN.
ALATYR_K8S_BROKER_TLS_CERT=

#: PEM-файл приватного ключа брокера. Обязателен, если задан ALATYR_K8S_BROKER_LISTEN.
# set me — never commit a real value
ALATYR_K8S_BROKER_TLS_KEY=

# Directory of trusted TPM manufacturer CA certs. (default: ./tpm-ca)
TPM_CA_DIR=./tpm-ca

# Best-effort online recovery of missing Intel PTT EK certs. Disable on air-gapped servers. (default: true)
TPM_INTEL_EK_RECOVERY=true

# Override the Intel EK service URL (testing/mirrors).
TPM_INTEL_EK_SERVER_URL=

# Reject TPM-resident keys with no obtainable EK cert (high-assurance). (default: false)
TPM_REJECT_UNATTESTED=false

# Reject proofs with platform=software (no TPM/Secure Enclave at all). Default false to preserve existing hardware-less enrollment; opt in for high-assurance fleets. (default: false)
TPM_REJECT_SOFTWARE=false

# Fleet-wide enforcement switch for TPM2_Certify AK-to-EK proof-of-possession: rejects platform=tpm2 proofs that fail/omit AK-Certify verification instead of only reporting it via ak_verified. Default false (off, informational-only rollout). Brand-new var, no legacy alias -- see the design spec's Server changes/Rollout sections. (default: false)
TPM_REQUIRE_AK_CERTIFY=false

# Vault server address.
VAULT_ADDR=

# Static Vault token (used when role_id is empty).
# set me — never commit a real value
VAULT_TOKEN=

# Vault AppRole role_id (production).
VAULT_ROLE_ID=

# Vault AppRole secret_id (production).
# set me — never commit a real value
VAULT_SECRET_ID=

# Vault PKI mount path. (default: pki)
VAULT_PKI_MOUNT=pki

# Vault PKI role name. (default: alatyr)
VAULT_PKI_ROLE=alatyr

# Optional PEM bundle for Vault TLS.
VAULT_CA_CERT_PATH=

# Issued certificate TTL in hours (default 3 years). (default: 26280)
VAULT_CERT_TTL_HOURS=26280

# Keycloak base URL.
KEYCLOAK_URL=

# Keycloak realm.
KEYCLOAK_REALM=

# Keycloak OIDC client id.
KEYCLOAK_CLIENT_ID=

# Keycloak OIDC client secret (confidential client).
# set me — never commit a real value
KEYCLOAK_CLIENT_SECRET=

# ── docker-compose host-only variables (NOT read by the server directly) ──
#
# DB_PASSWORD — ОБЯЗАТЕЛЕН для `docker compose up -d`. Состав подставляет его и
# в `POSTGRES_PASSWORD` самой базы, и в строку подключения сервера, которую
# собирает сам. Пустое значение раньше уезжало в postgres, и развёртывание
# падало ЕГО сообщением про суперпользователя, а не нашим; теперь состав
# отказывает сам и называет, что задать.
#   openssl rand -base64 24
DB_PASSWORD=
