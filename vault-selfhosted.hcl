# Vault для самостоятельной поставки Alatyr (GitLab dexion #784).
#
# Отличие от демо-стека одно, и оно решающее: здесь НЕ `vault server -dev`.
# Демонстрационный Vault держит всё в памяти и распечатывается сам, поэтому
# перезапуск контейнера уничтожает корневой ключ УЦ вместе со всеми выданными
# сертификатами — для пилота это неприемлемо.

storage "file" {
  path = "/vault/file"
}

listener "tcp" {
  address = "0.0.0.0:8200"

  # TLS выключен намеренно и допустимо ТОЛЬКО потому, что этот слушатель не
  # публикуется наружу: в docker-compose.selfhosted.yml у сервиса vault нет
  # `ports:`, он доступен лишь по внутренней сети compose. Как только Vault
  # выносится на отдельный хост — включать TLS обязательно, иначе токен
  # AppRole и подписанные сертификаты идут по сети открытым текстом.
  tls_disable = true
}

# Адрес, который Vault называет сам себе и кладёт в URL точек распространения.
api_addr = "http://vault:8200"

ui = false
